# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ONLYOFFICE container runtime state + clinic font files (licensed, and large)
/deploy/onlyoffice/data/
/deploy/onlyoffice/fonts/*
!/deploy/onlyoffice/fonts/.gitkeep

# clinic template files & sensitive docs — do not push to GitHub
/fwdsonographyformat/
/fwdxrayformat/
sheet-copy.html
sample.doc
Report_Rakesh_Bedi.docx

.vercel
